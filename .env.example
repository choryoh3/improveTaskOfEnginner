# 実値は .env.local に書く(コミット禁止)
DB_TARGET=sqlite

# sqlite
SQLITE_DATABASE_URL="file:./dev.db"

# postgres (Supabase): 実行時はプーラー、マイグレーションは直結
DATABASE_URL=
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 「今日」「今週」の境界に使う固定オフセット(分)。JST は 540、未設定は UTC
APP_TZ_OFFSET_MIN=540
